---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { renderMarkdown } from '../../lib/markdown';
import { splitPostBody } from '../../lib/post';
import { SERIES_HOME_HREF, SITE_NAME, seriesBadge } from '../../lib/site';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => data.status === 'published');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const { main, action, teaser } = splitPostBody(post.body);
const mainHtml = await renderMarkdown(main);
const actionHtml = action ? await renderMarkdown(action.content) : '';

const published = await getCollection('posts', ({ data: item }) => item.status === 'published');
const nextInSeries =
	data.series != null && data.episode != null
		? published.find((item) => item.data.series === data.series && item.data.episode === data.episode + 1)
		: undefined;

const badge = seriesBadge(data.series, data.episode);
const nextTitle = nextInSeries?.data.title ?? teaser?.title;
const nextHook = nextInSeries?.data.description ?? teaser?.hook;
const nextHref = nextInSeries ? `/posts/${nextInSeries.id}` : undefined;
---

<Base title={data.title} description={data.description} ogImage={data.ogImage}>
	<header class="topbar">
		<a class="brand" href={SERIES_HOME_HREF}>{SITE_NAME}</a>
		<a class="nav-link" href={SERIES_HOME_HREF}>返回系列</a>
	</header>

	<article class="article">
		{badge && <p class="badge">{badge}</p>}
		<h1>{data.title}</h1>
		{data.description && <p class="lead">{data.description}</p>}

		<div class="prose" set:html={mainHtml} />

		{
			action && (
				<section class="do-today" aria-labelledby="do-today-heading">
					<h2 id="do-today-heading">{action.heading}</h2>
					{action.hint && <p class="hint">{action.hint}</p>}
					<div class="prose" set:html={actionHtml} />
				</section>
			)
		}

		{
			nextTitle && (
				nextHref ? (
					<a class="teaser" href={nextHref}>
						<p class="kicker">下篇预告</p>
						<h2>{nextTitle}</h2>
						{nextHook && <p>{nextHook}</p>}
					</a>
				) : (
					<aside class="teaser">
						<p class="kicker">下篇预告</p>
						<h2>{nextTitle}</h2>
						{nextHook && <p>{nextHook}</p>}
					</aside>
				)
			)
		}
	</article>

	<footer class="site-footer">
		<a class="nav-link" href={SERIES_HOME_HREF}>返回系列首页</a>
	</footer>

	<script>
		function replaceMissingImage(img: HTMLImageElement) {
			const ph = document.createElement('span');
			ph.className = 'img-ph';
			ph.setAttribute('role', 'img');
			ph.setAttribute('aria-label', img.alt ? `图片暂缺：${img.alt}` : '图片暂缺');
			ph.textContent = '图片暂缺';
			img.replaceWith(ph);
		}

		document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
			img.addEventListener('error', () => replaceMissingImage(img));
			if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) {
				replaceMissingImage(img);
			}
		});
	</script>
</Base>
